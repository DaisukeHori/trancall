{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-native",
    "lib": ["ES2022", "DOM"],
    "paths": {
      "react-native": ["./node_modules/react-native"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": ["dist", "node_modules", "__tests__"]
}
