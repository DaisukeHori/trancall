# TranCall Translation Agent — 環境変数サンプル
#
# 本番環境では Render / Fly.io / Cloud Run の Dashboard で設定する。
# ローカル開発では `cp .env.example .env` してから値を埋める。

# --- LiveKit ---
LIVEKIT_URL=wss://trancall-xxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
# 任意（デフォルトは wss://api.openai.com/v1/realtime/translations）
# OPENAI_REALTIME_TRANSLATE_URL=wss://api.openai.com/v1/realtime/translations

# --- TranCall Server 内部 API ---
# 32 文字以上の HMAC 共有鍵。Server 側と完全に一致させること。
# 鍵を変更する際は Agent / Server 双方を rolling restart する。
TRANCALL_AGENT_HMAC_SECRET=replace-me-with-a-32-char-random-string-please

# Agent → Server コールバック URL
TRANCALL_SERVER_URL=https://api.trancall.app

# --- Worker / Logging ---
AGENT_NAME=trancall-translation-agent
LOG_LEVEL=info
NODE_ENV=production

# --- 任意 ---
# SENTRY_DSN=https://xxxx@sentry.io/xxxxx
