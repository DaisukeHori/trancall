# =============================================================================
# TranCall Environment Variables
# Copy to .env and fill in values
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...                    # Client-safe (RLS protected)
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # Server-only, never expose to client

# --- LiveKit ---
LIVEKIT_URL=wss://livekit.your-domain.com
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxx

# --- OpenAI ---
OPENAI_API_KEY=sk-...                       # Server-only (Translation Agent)

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...               # Server-only
STRIPE_WEBHOOK_SECRET=whsec_...             # Webhook signature verification
STRIPE_PUBLISHABLE_KEY=pk_live_...          # Client-safe

# --- Google Play (Pub/Sub Real-Time Developer Notifications) ---
# POST /api/billing/webhook/google に届く Google Cloud Pub/Sub push リクエストの
# OIDC ID トークン (Authorization: Bearer <token>) の audience 検証値。
# Google Cloud Console / gcloud で Pub/Sub push サブスクリプションを作成する際に設定した
# audience (通常は push endpoint の URL) と一致させること。
# 【要運用者設定】 実際の値はここに書けないダミー不可の運用値。未設定時は fail-close
# (Google Play webhook を常に 401 で拒否) となるため、Google Play 課金を有効化する前に
# 必ず設定すること。
GOOGLE_PLAY_PUBSUB_AUDIENCE=https://api.trancall.app/api/billing/webhook/google

# --- Apple Push (APNs) ---
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.trancall.app
APNS_KEY_FILE=./certs/AuthKey_XXXXXXXXXX.p8 # VoIP Push certificate

# --- Firebase (FCM) ---
FCM_PROJECT_ID=trancall-xxxxx
FCM_SERVICE_ACCOUNT_KEY=./certs/firebase-sa.json

# --- Translation Agent ---
AGENT_SECRET=your-hmac-secret-for-internal-api  # Agent ↔ Server 認証
AGENT_MAX_ROOMS=10                              # 1プロセスあたり最大Room数
AGENT_MEMORY_LIMIT_MB=512                       # メモリ上限

# --- App ---
APP_URL=https://trancall.app                    # フロントエンドURL
API_URL=https://api.trancall.app                # APIサーバーURL
INTERNAL_API_URL=http://localhost:3001           # Agent→Server内部API

# --- Monitoring ---
LOG_LEVEL=info                                  # debug | info | warn | error
