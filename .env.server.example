# =============================================================================
# TranCall API Server 環境変数
# =============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # Server-only

LIVEKIT_URL=wss://livekit.your-domain.com
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxx

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.trancall.app
APNS_KEY_FILE=./certs/AuthKey_XXXXXXXXXX.p8

FCM_PROJECT_ID=trancall-xxxxx
FCM_SERVICE_ACCOUNT_KEY=./certs/firebase-sa.json

AGENT_SECRET=your-hmac-secret-for-internal-api

APP_URL=https://trancall.app
API_URL=https://api.trancall.app
LOG_LEVEL=info

# --- Observability (L-15) ---
# 論理環境識別 (staging/production を区別、NODE_ENV は Render/Vercel では常に production 固定のため別変数で管理)
ENVIRONMENT=production
